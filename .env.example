# Data mode: supabase (main/local) | backend (staging/prod Cloud Run)
NEXT_PUBLIC_DATA_MODE=supabase

# Supabase project settings (required when DATA_MODE=supabase; forbidden when backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Edge Functions and site URLs (supabase mode only)
NEXT_PUBLIC_EDGE_FUNCTIONS_BASE_URL=
EDGE_FUNCTIONS_BASE_URL=
NEXT_PUBLIC_SITE_URL=
PASSWORD_RESET_REDIRECT_URL=

# Zemen FastAPI backend (required when DATA_MODE=backend)
# staging: https://zemen-service-backend-staging-558278833956.europe-west4.run.app
# production: https://zemen-service-backend-prod-558278833956.europe-west4.run.app
NEXT_PUBLIC_API_BASE_URL=
API_BASE_URL=

# Optional server-only payment secrets for Next pay routes in backend mode
CHAPA_SECRET_KEY=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Google Analytics 4 measurement ID (tracking is off when empty)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-12MCV17KTL
