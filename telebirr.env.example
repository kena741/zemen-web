# Copy these into .env.local (gitignored). Never commit real secrets.
# Telebirr H5 C2B — server-only

TELEBIRR_ENVIRONMENT=production
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_APP_SECRET=
TELEBIRR_PRIVATE_KEY=
# Optional overrides:
# TELEBIRR_NOTIFY_URL=https://your-domain/api/pay/telebirr/notify
# TELEBIRR_BASE_URL=
# TELEBIRR_WEB_BASE_URL=
# Telebirr gateway often uses a private CA; set true only if Node trusts their certs.
TELEBIRR_VERIFY_SSL=false
